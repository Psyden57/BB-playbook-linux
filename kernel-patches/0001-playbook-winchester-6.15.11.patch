+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BlackBerry PlayBook (RIM "winchester", OMAP4430 ES2.2 HS).
+ *
+ * Reverse-engineered from the running QNX OS (2.0.0.4869) register map and
+ * the OS 2.0 IFS buildfile; no vendor DT exists.  Booted via a QNX-side
+ * kexec-style jump (r0=0, r1=0xffffffff, r2=DTB), not by the stock boot ROM.
+ *
+ * First-boot scope: memory, UART3 console, TWL6030 PMIC, eMMC on MMC2.
+ * QNX already muxed/ clocked the pads the OS used (UART3, I2C1, MMC2), so
+ * no pinctrl nodes are needed (and none are known yet).
+ */
+
+/dts-v1/;
+
+#include "omap443x.dtsi"
+
+/ {
+	model = "BlackBerry PlayBook (winchester)";
+	compatible = "blackberry,omap4-winchester", "ti,omap4430", "ti,omap4";
+
+	chosen {
+		stdout-path = &uart3;
+		bootargs = "console=ttyO2,115200n8 earlyprintk keep_bootcon ignore_loglevel maxcpus=1";
+	};
+
+	/* 2026-09-03: the bank MUST match the payload's load placement
+	 * (qnx2linux.c want[] = 0xA4000000; head.S derives PHYS_OFFSET from
+	 * the load address). The old 0x80000000+1GB bank put 576 MB of
+	 * memblock BELOW the kernel's PHYS_OFFSET — unlinear-mappable, and
+	 * bottom-up allocs (dram_sync steal, CMA) landing there (0xa1000000)
+	 * BUG'd dma_contiguous_remap with "in user region" (the bc=127 wall).
+	 * 448 MB = 0xa4000000..0xbfffffff. */
+	memory@a4000000 {
+		device_type = "memory";
+		reg = <0xa4000000 0x1c000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* kexec breadcrumb + DEBUG_LL capture rings (scatter-proven
+		 * survivor pages); read back from the QNX side after the WDT2
+		 * warm reset. Reserved (never allocated) but KEPT IN THE LINEAR
+		 * MAP — the kernel-proper's DEBUG_LL ring writes use
+		 * VA = PA + 0x40000000, which must be mapped. */
+		kexec_bc@88000000 {
+			reg = <0x88000000 0x1000>;
+		};
+		/* kexec breadcrumb page: reserved (never allocated) but KEPT IN
+		 * THE LINEAR MAP — kernel C-phase diagnostics write it via
+		 * VA = PA + 0x40000000 (0xD0000004). The ring pages stay no-map. */
+		kexec_bc@90000000 {
+			reg = <0x90000000 0x1000>;
+		};
+		kexec_bc@94000000 {
+			reg = <0x94000000 0x1000>;
+		};
+		kexec_bc@9fe00000 {
+			reg = <0x9fe00000 0x1000>;
+		};
+	};
+
+	/* PL310 L2 — the payload keeps QNX's enabled L2 in whatever state it
+	 * was left; the kernel's l2x0 driver reprograms aux/latency/prefetch
+	 * through omap4_l2c310_write_sec (monitor SMCs 0x102/0x109/0x113).
+	 * Latencies are the conservative 3-cycle values (QNX's 1-cycle
+	 * config is the prime suspect for the session's wedges/corruption). */
+	l2-cache@48242000 {
+		compatible = "arm,pl310-cache";
+		reg = <0x48242000 0x1000>;
+		cache-unified;
+		cache-level = <2>;
+		arm,tag-latency = <3 3 3>;
+		arm,data-latency = <3 3 3>;
+	};
+};
+
+/* PMIC — TWL6030 on I2C1 (0x48072000), slave 0x48, IRQ_SYS_1N */
+&i2c1 {
+	clock-frequency = <400000>;
+
+	twl: twl@48 {
+		reg = <0x48>;
+		interrupts = <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>;
+	};
+};
+
+#include "twl6030.dtsi"
+#include "twl6030_omap4.dtsi"
+
+/* Internal eMMC (Samsung, 64 GB class) on MMC2 @ 0x480B4000 — 8-bit, fixed */
+&mmc2 {
+	bus-width = <8>;
+	ti,non-removable;
+	status = "okay";
+};
+
+/* no external SD slot, no wifi SDIO brought up yet */
+&mmc1 {
+	status = "disabled";
+};
+&mmc3 {
+	status = "disabled";
+};
+&mmc4 {
+	status = "disabled";
+};
+&mmc5 {
+	status = "disabled";
+};

