@@ -39,6 +84,9 @@
 
 static int __init setup_early_printk(char *buf)
 {
+	/* PlayBook kexec: bc[10] = console visibility marker — earlyprintk
+	 * param parsed. pb_bc_put = L2-aware. */
+	pb_bc_put(0xD0000028, 0xC0DE0001);
