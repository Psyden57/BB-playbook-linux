+++ b/arch/arm/kernel/early_printk.c	2026-09-02 21:52:24.418630911 +0000
@@ -11,9 +11,43 @@
 #include <linux/string.h>
 
 extern void printascii(const char *);
+extern void pb_bc_put(unsigned int addr, unsigned int v);	/* PlayBook */
+
+/* PlayBook kexec: mirror all console output into ring3 (PA 0x94000100,
+ * reached through the 0xD4000000 early-map section — same lifetime as the
+ * 0xD00 bc section). The UART output is invisible (no pad wired), but the
+ * ring survives the WDT2 reset and is readable via memdump3. The index is
+ * bounded (8 KB window) and written to the ring header at 0xD4000084 so
+ * the readback knows how much is fresh. */
+static unsigned int pb_ring_idx;
+
+/* PlayBook kexec: batched ring flush. The ring sections (0xC80/0xD00/
+ * 0xD40) are CACHEABLE (r7) — their stores ride the L1/L2 WB path (safe
+ * with the L2 on; sustained DEVICE stores wedge this machine). Push the
+ * touched ring lines to DRAM once per chunk via the secure 0x101 range
+ * flush (synchronous, no sync polls). With the L2 off the guard skips. */
+void pb_flush_rings(void)
+{
+	unsigned int base, pa;
+
+	if (!(*(volatile unsigned int *)0xFEB42100 & 1))
+		return;					/* L2 off: nothing dirty */
+
+	for (base = 0xD4000000u; ; base -= 0x4000000u) {	/* 0xD40/0xD00/0xC80 */
+		extern void pb_smc_flush(unsigned long pa, unsigned long size);
+		pa = (base + 0x80) - 0x40000000u;
+		pb_smc_flush(pa, 0x500);		/* count/idx/char window */
+		if (base == 0xC8000000u)
+			break;
+	}
+	dsb(sy);
+}
 
 static void early_write(const char *s, unsigned n)
 {
+	/* PlayBook kexec: bc[10] = console visibility marker — early_write
+	 * reached. pb_bc_put = L2-aware (flushed when the PL310 is on). */
+	pb_bc_put(0xD0000028, 0xC0DE0002);
 	char buf[128];
 	while (n) {
 		unsigned l = min(n, sizeof(buf)-1);
@@ -22,7 +56,18 @@
 		s += l;
 		n -= l;
 		printascii(buf);
+		{
+			volatile char *ring = (volatile char *)0xD4000100;
+			unsigned int i;
+
+			for (i = 0; i < l; i++) {
+				ring[pb_ring_idx] = buf[i];
+				pb_ring_idx = (pb_ring_idx + 1) & 0x1FFF;
+			}
+			*(volatile unsigned int *)0xD4000084 = pb_ring_idx;
+		}
 	}
+	pb_flush_rings();
 }
 
